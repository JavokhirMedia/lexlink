  key["ixtiyoriy: <code>GEMINI_API_KEY</code><br/>../creds.txt → ssh stdin (chop etilmaydi)"]:::ext
  ssh["SSH → <code>root@VPS</code><br/>(<code>~/.ssh/<ssh-key></code>)"]
  pull["<code>/opt/lexlink/src</code><br/>git fetch + reset --hard origin/main<br/>(read-only deploy key)"]
