# LexLink production env template. deploy.sh creates /opt/lexlink/.env from this on
# first run, replacing every __RANDOM_*__ placeholder. Never commit the real file.
APP_NAME=LexLink
APP_ENV=production
APP_KEY=__RANDOM_APP_KEY__
APP_DEBUG=false
APP_URL=https://hackathon.john.uz

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lexlink
DB_USERNAME=lexlink
DB_PASSWORD=__RANDOM_DB_PASSWORD__
# used only by the mysql container
DB_ROOT_PASSWORD=__RANDOM_DB_ROOT_PASSWORD__

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@hackathon.john.uz"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb: server listens on 0.0.0.0:8080 inside the "reverb" container.
# REVERB_HOST/PORT/SCHEME = how Laravel (app/horizon) reaches it on the docker network.
REVERB_APP_ID=__RANDOM_REVERB_APP_ID__
REVERB_APP_KEY=__RANDOM_REVERB_APP_KEY__
REVERB_APP_SECRET=__RANDOM_REVERB_APP_SECRET__
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Baked into the JS bundle at build time (docker-compose build args).
# Browser connects wss://hackathon.john.uz:443/app/{key} -> Cloudflare -> nginx -> reverb.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=hackathon.john.uz
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Mock government APIs — internal call app -> nginx container (plain HTTP).
MOCK_GOV_BASE_URL=http://nginx/mock-gov/v1
MOCK_GOV_API_KEY=mock-gov-demo-key

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=

# OneID (mock flow for the demo)
ONEID_CLIENT_ID=
ONEID_CLIENT_SECRET=

LEXLINK_RESPONSE_RETENTION_DAYS=30

# AI (Gemini) + lex.uz RAG
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LEXLINK_MIN_WAGE=1360000
